{
  "name": "campus-movie-hunt",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Campus Movie Hunt — an individual, timed campus game. Recognise a movie scene, walk to where it was shot, and watch it come alive in AR. Server-authoritative, par-time scored.",
  "workspaces": [
    "shared",
    "api",
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -b shared && tsc -p scripts && npm run typecheck --workspace api && npm run check --workspace client",
    "lint": "oxlint",
    "dev:client": "npm run dev --workspace client",
    "dev:api": "npm run dev --workspace api",
    "sim": "tsx scripts/sim-hunt.ts",
    "gen:routes": "tsx scripts/generate-route-pool.ts",
    "deploy:api": "bash scripts/deploy-api.sh",
    "deploy:client": "bash scripts/deploy-client.sh",
    "deploy": "bash scripts/deploy-api.sh && bash scripts/deploy-client.sh"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.80.0",
    "@types/node": "^26.2.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

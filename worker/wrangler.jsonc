{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campus-movie-hunt-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campus_movie_hunt",
      // Replace with the real id after `wrangler d1 create campus_movie_hunt`.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "STANDINGS", "class_name": "StandingsRoom" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StandingsRoom"] }
  ]
}
